-- SCRIPT HITBOX TO HIỂN THỊ CHO PLAYER
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local HITBOX_SIZE = Vector3.new(5, 6, 5) -- chỉnh to nhỏ ở đây
local HITBOX_COLOR = Color3.fromRGB(255, 0, 0) -- đỏ, dễ nhìn
local HITBOX_TRANSPARENCY = 0.5           -- 0.5 = bán trong suốt
local HITBOX_CANCOLLIDE = false            -- không va chạm vật khác

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        local root = char:WaitForChild("HumanoidRootPart")

        -- tạo part hitbox
        local hitbox = Instance.new("Part")
        hitbox.Size = HITBOX_SIZE
        hitbox.Transparency = HITBOX_TRANSPARENCY
        hitbox.Color = HITBOX_COLOR
        hitbox.CanCollide = HITBOX_CANCOLLIDE
        hitbox.Anchored = true
        hitbox.Parent = char
        hitbox.Name = "VisibleHitbox"

        -- cập nhật vị trí theo player
        RunService.RenderStepped:Connect(function()
            if char.Parent then
                hitbox.CFrame = root.CFrame
            end
        end)
    end)
end)
