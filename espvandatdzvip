--================ KEY SYSTEM =================--

local FILE = "vandat_key.json"

local function getHWID()
    if not isfile("hwid.txt") then
        local id = tostring(math.random(1000,9999))
        writefile("hwid.txt", id)
        return id
    end
    return readfile("hwid.txt")
end

local HWID = getHWID()
local VALID_KEY = "vandatdz-"..HWID

local function saveKey()
    local data = {key = VALID_KEY, time = os.time()}
    writefile(FILE, HttpService:JSONEncode(data))
end

local function loadKey()
    if not isfile(FILE) then return false end
    local data = HttpService:JSONDecode(readfile(FILE))

    if data.key ~= VALID_KEY then return false end

    local diff = os.time() - data.time
    if diff <= 86400 then
        return true, 86400 - diff
    else
        delfile(FILE)
        return false
    end
end

local function formatTime(sec)
    local h = math.floor(sec/3600)
    local m = math.floor((sec%3600)/60)
    local s = sec%60
    return string.format("%02d:%02d:%02d", h,m,s)
end

--================ MENU =================--

local ESP = true
local LINE = true

local function createMenu()
    local gui = Instance.new("ScreenGui", game.CoreGui)

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,240,0,220)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    -- TITLE
    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,30)
    title.Text = "Menu VandatdzESP"
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.Font = Enum.Font.GothamBold

    -- CREDIT
    local credit = Instance.new("TextLabel", main)
    credit.Size = UDim2.new(1,0,0,20)
    credit.Position = UDim2.new(0,0,1,-20)
    credit.Text = "by:vandatdz"
    credit.BackgroundTransparency = 1
    credit.TextColor3 = Color3.fromRGB(150,150,150)

    -- KEY HIỂN THỊ
    local keyLabel = Instance.new("TextLabel", main)
    keyLabel.Size = UDim2.new(1,0,0,20)
    keyLabel.Position = UDim2.new(0,0,0,30)
    keyLabel.BackgroundTransparency = 1
    keyLabel.TextColor3 = Color3.fromRGB(255,255,0)
    keyLabel.Text = "Key: "..VALID_KEY

    -- COPY KEY
    local copyBtn = Instance.new("TextButton", main)
    copyBtn.Size = UDim2.new(0.6,0,0,25)
    copyBtn.Position = UDim2.new(0.2,0,0,55)
    copyBtn.Text = "COPY KEY"
    copyBtn.BackgroundColor3 = Color3.fromRGB(0,170,255)
    copyBtn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", copyBtn)

    copyBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(VALID_KEY)
            copyBtn.Text = "Đã copy!"
            wait(1)
            copyBtn.Text = "COPY KEY"
        end
    end)

    -- TIME
    local timeText = Instance.new("TextLabel", main)
    timeText.Size = UDim2.new(1,0,0,20)
    timeText.Position = UDim2.new(0,0,0,85)
    timeText.BackgroundTransparency = 1
    timeText.TextColor3 = Color3.fromRGB(0,255,0)

    spawn(function()
        while true do
            local valid, t = loadKey()
            if not valid then
                timeText.Text = "Key hết hạn!"
                break
            end
            timeText.Text = "Time: "..formatTime(t)
            wait(1)
        end
    end)

    -- BUTTON
    local function button(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,30)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
        b.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    button("ESP",110,ESP,function(v) ESP=v end)
    button("LINE",150,LINE,function(v) LINE=v end)

    -- DRAG
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            start = i.Position
            pos = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.Touch then
            local delta = i.Position - start
            main.Position = UDim2.new(pos.X.Scale,pos.X.Offset+delta.X,pos.Y.Scale,pos.Y.Offset+delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

--================ ESP =================--

local function esp(p)
    if p == LocalPlayer then return end

    local box = Drawing.new("Square")
    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    local bones = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"}
    }

    local skel = {}
    for i=1,#bones do
        local l = Drawing.new("Line")
        l.Color = Color3.fromRGB(255,255,255)
        table.insert(skel,l)
    end

    RunService.RenderStepped:Connect(function()
        local c = p.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local hrp = c.HumanoidRootPart
            local pos, vis = Camera:WorldToViewportPoint(hrp.Position)

            if vis and ESP then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                local scale = math.clamp(1/(dist/300),0.3,1)

                box.Size = Vector2.new(30*scale,50*scale)
                box.Position = Vector2.new(pos.X-(15*scale),pos.Y-(25*scale))
                box.Color = Color3.fromRGB(255,0,0)
                box.Visible = true

                text.Position = Vector2.new(pos.X,pos.Y-(30*scale))
                text.Text = p.Name.." ["..math.floor(dist).."m]"
                text.Visible = true

                if LINE then
                    line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X,pos.Y)
                    line.Color = Color3.fromRGB(0,255,0)
                    line.Visible = true
                else
                    line.Visible = false
                end

                for i,b in ipairs(bones) do
                    local p1 = c:FindFirstChild(b[1])
                    local p2 = c:FindFirstChild(b[2])
                    if p1 and p2 then
                        local a,v1 = Camera:WorldToViewportPoint(p1.Position)
                        local b2,v2 = Camera:WorldToViewportPoint(p2.Position)
                        if v1 and v2 then
                            skel[i].From = Vector2.new(a.X,a.Y)
                            skel[i].To = Vector2.new(b2.X,b2.Y)
                            skel[i].Visible = true
                        else
                            skel[i].Visible = false
                        end
                    end
                end

            else
                box.Visible = false
                line.Visible = false
                text.Visible = false
                for _,l in pairs(skel) do l.Visible=false end
            end
        end
    end)
end

