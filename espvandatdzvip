local function createMenu()
    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,240,0,240)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,30)
    title.Text = "Menu Vandatdz Esp"
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.Font = Enum.Font.GothamBold

    local function button(name,y,callback)
        local state = false

        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,30)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": OFF"
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
        b.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    button("ESP",50,function(v) ESP=v end)
    button("LINE",90,function(v) LINE=v end)
    button("HITBOX",130,function(v) HITBOX=v end)
    button("AIMLOCK",170,function(v) AIMLOCK=v end)
    button("SKELETON",210,function(v) SKELETON=v end)

    -- DRAG FIX (PC + MOBILE)
    local dragging = false
    local dragStart, startPos

    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

--================ ESP =================--

local function removeESP(p)
    if ESP_CACHE[p] then
        for _,v in pairs(ESP_CACHE[p]) do
            if typeof(v) == "RBXScriptConnection" then
                v:Disconnect()
            elseif v.Remove then
                v:Remove()
            end
        end
        ESP_CACHE[p] = nil
    end
end

local function esp(p)
    if p == LocalPlayer then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not p.Parent then
            removeESP(p)
            return
        end

        local c = p.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local pos, vis = Camera:WorldToViewportPoint(c.HumanoidRootPart.Position)

            if ESP and vis then
                text.Text = "@"..p.Name
                text.Position = Vector2.new(pos.X,pos.Y-30)
                text.Visible = true

                if LINE then
                    line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X,pos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                text.Visible = false
                line.Visible = false
            end
        end
    end)

    ESP_CACHE[p] = {line,text,conn}
end

