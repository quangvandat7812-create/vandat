-- DRAG
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    Frame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- LOGIN
local function successLogin()
    Status.TextColor3 = Color3.fromRGB(0,255,0)
    Status.Text = "Login Success!"

    saveData({
        key = VALID_KEY,
        time = os.time()
    })

    wait(1)
    Frame.Visible = false -- 🔥 không xoá nữa

    loadstring(game:HttpGet("https://raw.githubusercontent.com/quangvandat7812-create/vandat/main/esp.lua"))()
end

local function doLogin(key)
    if key == VALID_KEY then
        successLogin()
    else
        Status.Text = "Wrong Key!"
    end
end

Button.MouseButton1Click:Connect(function()
    doLogin(Box.Text)
end)

-- GET KEY CLICK
GetKey.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_LINK)
        Status.Text = "Link copied!"
    else
        Status.Text = "Copy link manually!"
    end
end)

-- AUTO LOGIN
local data = loadData()
if data and data.key == VALID_KEY and data.time then
    if os.time() - data.time < KEY_DURATION then
        successLogin()
    end
end
