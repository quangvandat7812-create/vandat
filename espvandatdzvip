btn.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", btn)

-- SETTINGS
local ESP = true
local LINE = true

-- MAIN MENU
local function createMenu()
    login:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,220,0,170)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    -- Title
    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,30)
    title.Text = "Menu VandatdzESP"
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.Font = Enum.Font.GothamBold

    -- Credit
    local credit = Instance.new("TextLabel", main)
    credit.Size = UDim2.new(1,0,0,20)
    credit.Position = UDim2.new(0,0,1,-20)
    credit.Text = "by:vandatdz"
    credit.BackgroundTransparency = 1
    credit.TextColor3 = Color3.fromRGB(150,150,150)

    -- Switch
    local function switch(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,35)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
        b.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    switch("ESP",40,ESP,function(v) ESP=v end)
    switch("LINE",85,LINE,function(v) LINE=v end)

    -- DRAG
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            start = i.Position
            pos = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.Touch then
            local delta = i.Position - start
            main.Position = UDim2.new(pos.X.Scale,pos.X.Offset+delta.X,pos.Y.Scale,pos.Y.Offset+delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)

    -- ESP
    local function esp(p)
        if p == LocalPlayer then return end

        local box = Drawing.new("Square")
        local line = Drawing.new("Line")
        local text = Drawing.new("Text")

        text.Size = 12
        text.Center = true
        text.Outline = true

        RunService.RenderStepped:Connect(function()
            local c = p.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                local hrp = c.HumanoidRootPart
                local pos, vis = Camera:WorldToViewportPoint(hrp.Position)

                if vis and ESP then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                    local scale = math.clamp(1/(dist/300),0.3,1)

                    box.Size = Vector2.new(30*scale,50*scale)
                    box.Position = Vector2.new(pos.X-(15*scale),pos.Y-(25*scale))
                    box.Color = Color3.fromRGB(255,0,0)
                    box.Visible = true

                    text.Position = Vector2.new(pos.X,pos.Y-(30*scale))
                    text.Text = p.Name.." ["..math.floor(dist).."m]"
                    text.Visible = true

                    if LINE then
                        line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                        line.To = Vector2.new(pos.X,pos.Y)
                        line.Color = Color3.fromRGB(0,255,0)
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                else
                    box.Visible = false
                    line.Visible = false
                    text.Visible = false
                end
            end
        end)
    end

    for _,v in pairs(Players:GetPlayers()) do esp(v) end
    Players.PlayerAdded:Connect(esp)
end

-- LOGIN CHECK
btn.MouseButton1Click:Connect(function()
    if box.Text == PASSWORD then
        createMenu()
    else
        box.Text = ""
        box.PlaceholderText = "Sai mật khẩu!"
    end
end)
