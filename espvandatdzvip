local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local ESP = true
local LINE = true
local AIM = false
local SILENT = false
local FOV = 120
local SMOOTH = 0.2

-- FOV
local circle = Drawing.new("Circle")
circle.Color = Color3.fromRGB(0,255,0)
circle.Radius = FOV
circle.Thickness = 1
circle.Filled = false

-- GUI MOBILE
local gui = Instance.new("ScreenGui", game.CoreGui)

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0,220,0,200)
main.Position = UDim2.new(0,20,0,200)
main.BackgroundColor3 = Color3.fromRGB(20,20,20)
Instance.new("UICorner", main)

local function makeBtn(txt,y)
    local b = Instance.new("TextButton", main)
    b.Size = UDim2.new(0.8,0,0,35)
    b.Position = UDim2.new(0.1,0,0,y)
    b.Text = txt
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", b)
    return b
end

local espB = makeBtn("ESP: ON",20)
local lineB = makeBtn("LINE: ON",60)
local aimB = makeBtn("AIM: OFF",100)
local silentB = makeBtn("SILENT: OFF",140)

espB.MouseButton1Click:Connect(function()
    ESP = not ESP
    espB.Text = "ESP: "..(ESP and "ON" or "OFF")
end)

lineB.MouseButton1Click:Connect(function()
    LINE = not LINE
    lineB.Text = "LINE: "..(LINE and "ON" or "OFF")
end)

aimB.MouseButton1Click:Connect(function()
    AIM = not AIM
    aimB.Text = "AIM: "..(AIM and "ON" or "OFF")
end)

silentB.MouseButton1Click:Connect(function()
    SILENT = not SILENT
    silentB.Text = "SILENT: "..(SILENT and "ON" or "OFF")
end)

-- DRAG MOBILE
local dragging, dragInput, start, pos

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        start = input.Position
        pos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - start
        main.Position = UDim2.new(pos.X.Scale,pos.X.Offset+delta.X,pos.Y.Scale,pos.Y.Offset+delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ESP
local function esp(p)
    if p == LocalPlayer then return end

    local box = Drawing.new("Square")
    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    text.Size = 13
    text.Center = true
    text.Outline = true

    RunService.RenderStepped:Connect(function()
        local c = p.Character
        if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChild("Humanoid") then
            local hrp = c.HumanoidRootPart
            local hum = c.Humanoid
            local pos, vis = Camera:WorldToViewportPoint(hrp.Position)

            if vis and ESP then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                local scale = math.clamp(1/(dist/100),0.5,2)

                box.Size = Vector2.new(50*scale,80*scale)
                box.Position = Vector2.new(pos.X-(25*scale),pos.Y-(40*scale))
                box.Color = Color3.fromRGB(255,0,0)
                box.Visible = true

                text.Position = Vector2.new(pos.X,pos.Y-(50*scale))
                text.Text = p.Name.." | "..math.floor(hum.Health).."HP | "..math.floor(dist).."m"
                text.Visible = true

                if LINE then
                    line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X,pos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                box.Visible = false
                line.Visible = false
                text.Visible = false
            end
        end
    end)
end

for _,v in pairs(Players:GetPlayers()) do esp(v) end
Players.PlayerAdded:Connect(esp)

-- AIM + SILENT
RunService.RenderStepped:Connect(function()
    circle.Position = UIS:GetMouseLocation()

    local closest, dist = nil, FOV

    for _,v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local pos, vis = Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            if vis then
                local mag = (Vector2.new(pos.X,pos.Y) - circle.Position).Magnitude
                if mag < dist then
                    dist = mag
                    closest = v
                end
            end
        end
    end

    if closest and closest.Character then
        local target = closest.Character.HumanoidRootPart.Position

        if AIM then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target), SMOOTH)
        end

        if SILENT then
            -- fake silent (look nhanh)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target)
        end
    end
end)
