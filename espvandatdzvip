-- SAVE KEY
local FILE = "vandat_key.txt"
local EXPIRE = 86400

local function saveKey(key)
    if writefile then
        writefile(FILE, HttpService:JSONEncode({
            key = key,
            time = os.time()
        }))
    end
end

local function loadKey()
    if readfile and isfile and isfile(FILE) then
        local data = HttpService:JSONDecode(readfile(FILE))
        if data and data.key and (os.time() - data.time <= EXPIRE) then
            return data.key
        end
    end
    return nil
end

