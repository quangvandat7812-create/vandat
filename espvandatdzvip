local function createMenu()
    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,240,0,180)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,30)
    title.Text = "Menu VandatdzESP"
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.Font = Enum.Font.GothamBold

    local credit = Instance.new("TextLabel", main)
    credit.Size = UDim2.new(1,0,0,20)
    credit.Position = UDim2.new(0,0,1,-20)
    credit.Text = "by:vandatdz"
    credit.BackgroundTransparency = 1
    credit.TextColor3 = Color3.fromRGB(150,150,150)

    local function button(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,30)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
        b.TextColor3 = Color3.new(1,1,1)
        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    button("ESP",60,ESP,function(v) ESP=v end)
    button("LINE",100,LINE,function(v) LINE=v end)

    -- DRAG MENU
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            start = i.Position
            pos = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.Touch then
            local delta = i.Position - start
            main.Position = UDim2.new(pos.X.Scale,pos.X.Offset+delta.X,pos.Y.Scale,pos.Y.Offset+delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)

    --================ LOGO PNG TOGGLE MENU =================--

    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,65,0,65)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "rbxassetid://127839480332201"
    logo.BackgroundTransparency = 1

    local stroke = Instance.new("UIStroke", logo)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(0,255,255)

    local menuOpen = true

    logo.MouseButton1Click:Connect(function()
        menuOpen = not menuOpen
        main.Visible = menuOpen
    end)

    -- DRAG LOGO
    local dragging, startPos, startInput

    logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = logo.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startInput
            logo.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

--================ ESP =================--

local function esp(p)
    if p == LocalPlayer then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    text.Size = 14
    text.Center = true
    text.Outline = true
    text.Color = Color3.fromRGB(255,255,255)

    local bones = {
        {"Head","UpperTorso"},{"Head","Torso"},
        {"UpperTorso","LowerTorso"},{"Torso","HumanoidRootPart"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"Torso","Left Arm"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"Torso","Right Arm"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"Torso","Left Leg"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
        {"Torso","Right Leg"}
    }

    local skel = {}
    for i=1,#bones do
        local l = Drawing.new("Line")
        l.Color = Color3.fromRGB(255,255,255)
        l.Thickness = 3
        table.insert(skel,l)
    end

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not p.Parent then
            line:Remove()
            text:Remove()
            for _,l in pairs(skel) do l:Remove() end
            connection:Disconnect()
            return
        end

        local c = p.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local hrp = c.HumanoidRootPart
            local pos, vis = Camera:WorldToViewportPoint(hrp.Position)

            if vis and ESP then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude

                text.Position = Vector2.new(pos.X,pos.Y-40)
                text.Text = "@"..p.Name.." ["..math.floor(dist).."m]"
                text.Visible = true

                if LINE then
                    line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X,pos.Y)
                    line.Color = Color3.fromRGB(0,255,0)
                    line.Visible = true
                else
                    line.Visible = false
                end

                for i,b in ipairs(bones) do
                    local p1 = c:FindFirstChild(b[1], true)
                    local p2 = c:FindFirstChild(b[2], true)

                    if p1 and p2 then
                        local a,v1 = Camera:WorldToViewportPoint(p1.Position)
                        local b2,v2 = Camera:WorldToViewportPoint(p2.Position)

                        if v1 and v2 then
                            skel[i].From = Vector2.new(a.X,a.Y)
                            skel[i].To = Vector2.new(b2.X,b2.Y)
                            skel[i].Visible = true
                        else
                            skel[i].Visible = false
                        end
                    else
                        skel[i].Visible = false
                    end
                end
            else
                text.Visible = false
                line.Visible = false
                for _,l in pairs(skel) do l.Visible=false end
            end
        end
    end)
end

