--// VANDATDZ ESP + AIM + MENU (WORKING)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local ESP_ENABLED = true
local AIM_ENABLED = false

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0,200,0,150)
Main.Position = UDim2.new(0,100,0,200)
Main.BackgroundColor3 = Color3.fromRGB(20,20,20)

Main.Active = true
Main.Draggable = true

-- TITLE
local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1,0,0,30)
Title.BackgroundColor3 = Color3.fromRGB(0,0,0)
Title.Text = "VANDATDZ MENU"
Title.TextColor3 = Color3.fromRGB(0,170,255)

-- ESP BUTTON
local ToggleESP = Instance.new("TextButton", Main)
ToggleESP.Size = UDim2.new(1,-20,0,30)
ToggleESP.Position = UDim2.new(0,10,0,40)
ToggleESP.Text = "ESP: ON"
ToggleESP.BackgroundColor3 = Color3.fromRGB(40,40,40)
ToggleESP.TextColor3 = Color3.fromRGB(255,255,255)

-- AIM BUTTON
local ToggleAim = Instance.new("TextButton", Main)
ToggleAim.Size = UDim2.new(1,-20,0,30)
ToggleAim.Position = UDim2.new(0,10,0,80)
ToggleAim.Text = "AIM: OFF"
ToggleAim.BackgroundColor3 = Color3.fromRGB(40,40,40)
ToggleAim.TextColor3 = Color3.fromRGB(255,255,255)

-- TOGGLE
ToggleESP.MouseButton1Click:Connect(function()
	ESP_ENABLED = not ESP_ENABLED
	ToggleESP.Text = "ESP: "..(ESP_ENABLED and "ON" or "OFF")
end)

ToggleAim.MouseButton1Click:Connect(function()
	AIM_ENABLED = not AIM_ENABLED
	ToggleAim.Text = "AIM: "..(AIM_ENABLED and "ON" or "OFF")
end)

-- ESP FUNCTION (Highlight + Name)
local function SetupESP(player)
	if player == LocalPlayer then return end

	player.CharacterAdded:Connect(function(char)
		repeat task.wait() until char:FindFirstChild("HumanoidRootPart")

		-- Highlight (box)
		local hl = Instance.new("Highlight", char)
		hl.FillColor = Color3.fromRGB(255,0,0)
		hl.OutlineColor = Color3.fromRGB(255,255,255)

		-- Name + distance
		local bill = Instance.new("BillboardGui", char)
		bill.Size = UDim2.new(0,100,0,40)
		bill.AlwaysOnTop = true
		bill.Adornee = char:WaitForChild("HumanoidRootPart")

		local text = Instance.new("TextLabel", bill)
		text.Size = UDim2.new(1,0,1,0)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.new(1,1,1)
		text.TextScaled = true

		RunService.RenderStepped:Connect(function()
			if not ESP_ENABLED then
				hl.Enabled = false
				bill.Enabled = false
				return
			end

			hl.Enabled = true
			bill.Enabled = true

			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude)
				text.Text = player.Name.." ["..dist.."m]"
			end
		end)
	end)
end

-- APPLY ESP
for _,v in pairs(Players:GetPlayers()) do
	SetupESP(v)
end

Players.PlayerAdded:Connect(SetupESP)

-- GET CLOSEST
local function GetClosest()
	local closest, dist = nil, math.huge

	for _,v in pairs(Players:GetPlayers()) do
		if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
			local mag = (LocalPlayer.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
			if mag < dist then
				dist = mag
				closest = v
			end
		end
	end

	return closest
end

-- AIM
RunService.RenderStepped:Connect(function()
	if AIM_ENABLED and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local target = GetClosest()
		if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
		end
	end
end)
