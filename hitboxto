--================ ESP =================--

local function createESP(p)
    if p == LocalPlayer then return end
    if ESP_CACHE[p] then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    text.Size = 16
    text.Center = true
    text.Outline = true
    text.Color = Color3.new(1,1,1)

    local conn

    local function remove()
        if line then line:Remove() end
        if text then text:Remove() end
        if conn then conn:Disconnect() end
        ESP_CACHE[p] = nil
    end

    conn = RunService.RenderStepped:Connect(function()
        if not p or not p.Parent then
            remove()
            return
        end

        local c = p.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        local hum = c and c:FindFirstChild("Humanoid")

        if not c or not hrp or not hum or hum.Health <= 0 then
            text.Visible = false
            line.Visible = false
            return
        end

        local pos, vis = Camera:WorldToViewportPoint(hrp.Position)

        if ESP and vis then
            text.Text = "@"..p.Name
            text.Position = Vector2.new(pos.X,pos.Y-30)
            text.Visible = true

            if LINE then
                line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X,pos.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            text.Visible = false
            line.Visible = false
        end
    end)

    p.AncestryChanged:Connect(function(_, parent)
        if not parent then
            remove()
        end
    end)

    p.CharacterRemoving:Connect(function()
        text.Visible = false
        line.Visible = false
    end)

    ESP_CACHE[p] = true
end

--================ SKELETON =================--

local function createSkeleton(p)
    if p == LocalPlayer then return end

    local lines = {}
    for i=1,6 do
        lines[i] = Drawing.new("Line")
        lines[i].Thickness = 2
        lines[i].Color = Color3.fromRGB(0,255,255)
    end

    local conn

    local function remove()
        for _,l in pairs(lines) do l:Remove() end
        if conn then conn:Disconnect() end
    end

    conn = RunService.RenderStepped:Connect(function()
        if not p or not p.Parent then
            remove()
            return
        end

        local c = p.Character
        if not c or not SKELETON then
            for _,l in pairs(lines) do l.Visible = false end
            return
        end

        local head = c:FindFirstChild("Head")
        local root = c:FindFirstChild("HumanoidRootPart")

        if head and root then
            local h = Camera:WorldToViewportPoint(head.Position)
            local r = Camera:WorldToViewportPoint(root.Position)

            lines[1].From = Vector2.new(h.X,h.Y)
            lines[1].To = Vector2.new(r.X,r.Y)
            lines[1].Visible = true
        end
    end)
end

--================ HITBOX =================--

local function applyHitbox(p)
    RunService.RenderStepped:Connect(function()
        if not p or not p.Parent then return end
        local c = p.Character
        if not c then return end

        for _,part in pairs(c:GetChildren()) do
            if part:IsA("BasePart") then
                if HITBOX then
                    part.Color = Color3.fromRGB(255,0,0)
                    part.Material = Enum.Material.Neon
                    part.Transparency = 0.5
                    part.CanCollide = false
                else
                    part.Transparency = 0
                    part.Material = Enum.Material.Plastic
                end
            end
        end
    end)
end

--================ AIM =================--

local function getClosest()
    local closest, dist = nil, AIM_FOV
    for _,v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
            local pos, vis = Camera:WorldToViewportPoint(v.Character.Head.Position)
            if vis then
                local d = (Vector2.new(pos.X,pos.Y) - Camera.ViewportSize/2).Magnitude
                if d < dist then
                    dist = d
                    closest = v
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if AIMLOCK then
        local t = getClosest()
        if t and t.Character and t.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Character.Head.Position)
        end
    end
end)

