--================ MENU =================--

local main

local function createMenu()
    frame:Destroy()

    main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,220,0,200)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,60,0,60)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "https://www.roblox.com/asset/?id=127839480332201"
    logo.BackgroundTransparency = 1

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)

    -- DRAG LOGO
    local dragging, startPos, startInput

    logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = logo.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            logo.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function()
        dragging = false
    end)
end

--================ PLAYER =================--

local function addPlayer(p)
    if p == LocalPlayer then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    text.Size = 14
    text.Center = true
    text.Outline = true

    CACHE[p] = {
        line = line,
        text = text,
        highlight = nil
    }
end

local function removePlayer(p)
    if CACHE[p] then
        CACHE[p].line:Remove()
        CACHE[p].text:Remove()
        if CACHE[p].highlight then
            CACHE[p].highlight:Destroy()
        end
        CACHE[p] = nil
    end
end

--================ LOOP =================--

RunService.RenderStepped:Connect(function()

    for p,data in pairs(CACHE) do
        local char = p.Character

        if not char or not char:FindFirstChild("HumanoidRootPart") then
            data.text.Visible = false
            data.line.Visible = false
            continue
        end

        local root = char.HumanoidRootPart
        local pos, vis = Camera:WorldToViewportPoint(root.Position)

        -- ESP
        if ESP and vis then
            data.text.Text = p.Name
            data.text.Position = Vector2.new(pos.X,pos.Y-30)
            data.text.Visible = true
        else
            data.text.Visible = false
        end

        -- LINE
        if LINE and vis then
            data.line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
            data.line.To = Vector2.new(pos.X,pos.Y)
            data.line.Visible = true
        else
            data.line.Visible = false
        end

        -- HITBOX
        if HITBOX then
            if not data.highlight then
                data.highlight = Instance.new("Highlight")
                data.highlight.FillTransparency = 1
                data.highlight.OutlineColor = Color3.fromRGB(255,0,0)
                data.highlight.Parent = char
            end
            root.Size = HITBOX_SIZE
        else
            if data.highlight then
                data.highlight:Destroy()
                data.highlight = nil
            end
            root.Size = Vector3.new(2,2,1)
        end
    end
end)

--================ START =================--

local function start()
    createMenu()

    for _,p in pairs(Players:GetPlayers()) do
        addPlayer(p)
    end

    Players.PlayerAdded:Connect(addPlayer)
    Players.PlayerRemoving:Connect(removePlayer)
end

-- AUTO LOGIN
if loadKey() == KEY then
    start()
end

btn.MouseButton1Click:Connect(function()
    if box.Text == KEY then
        saveKey(KEY)
        start()
    else
        box.Text = ""
    end
end)
