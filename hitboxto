    end

    button("ESP",50,ESP,function(v) ESP=v end)
    button("LINE",90,LINE,function(v) LINE=v end)
    button("HITBOX",130,HITBOX,function(v) HITBOX=v end)
    button("AIMLOCK",170,AIMLOCK,function(v) AIMLOCK=v end)
    button("SKELETON",210,SKELETON,function(v) SKELETON=v end)

    --================ LOGO (DRAG FULL) =================--

    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,65,0,65)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "https://www.roblox.com/asset/?id=127839480332201"
    logo.BackgroundTransparency = 1

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)

    -- DRAG
    local dragging = false
    local dragStart
    local startPos

    logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = logo.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
        or input.UserInputType == Enum.UserInputType.Touch) then

            local delta = input.Position - dragStart

            logo.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)
end

--================ HITBOX =================--

local function applyHitbox(p)
    local highlight

    RunService.RenderStepped:Connect(function()
        if not p.Parent then return end

        local char = p.Character
        if char and char:FindFirstChild("HumanoidRootPart") then

            local root = char.HumanoidRootPart

            if HITBOX then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.FillTransparency = 1
                    highlight.OutlineColor = Color3.fromRGB(255,0,0)
                    highlight.Parent = char
                end
                root.Size = HITBOX_SIZE
            else
                if highlight then
                    highlight:Destroy()
                    highlight = nil
                end
                root.Size = Vector3.new(2,2,1)
            end
        end
    end)
end

--================ AIM =================--

local function getClosest()
    local closest, dist = nil, AIM_FOV

    for _,v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
            local pos, vis = Camera:WorldToViewportPoint(v.Character.Head.Position)
            if vis then
                local d = (Vector2.new(pos.X,pos.Y) - Camera.ViewportSize/2).Magnitude
                if d < dist then
                    dist = d
                    closest = v
                end
            end
        end
    end

    return closest
end

RunService.RenderStepped:Connect(function()
    if AIMLOCK then
        local t = getClosest()
        if t and t.Character and t.Character:FindFirstChild("Head") then
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, t.Character.Head.Position),
                0.2
            )
        end
    end
end)

--================ ESP =================--

local function esp(p)
    if p == LocalPlayer then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    text.Size = 14
    text.Center = true
    text.Outline = true

    RunService.RenderStepped:Connect(function()
        if not p.Parent then
            line:Remove()
            text:Remove()
            return
        end

        local c = p.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local pos, vis = Camera:WorldToViewportPoint(c.HumanoidRootPart.Position)

            if ESP and vis then
                text.Text = "@"..p.Name
                text.Position = Vector2.new(pos.X,pos.Y-30)
                text.Visible = true

                if LINE then
                    line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X,pos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                text.Visible = false
                line.Visible = false
            end
        else
            text.Visible = false
            line.Visible = false
        end
    end)
end

--================ START =================--

local function start()
    createMenu()

    for _,v in pairs(Players:GetPlayers()) do
        esp(v)
        applyHitbox(v)
    end

    Players.PlayerAdded:Connect(function(v)
        esp(v)
        applyHitbox(v)
    end)
end

