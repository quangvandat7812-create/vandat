local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- KEY
local KEY = "vandatdz"
local FILE = "vandat_key.txt"

-- SETTINGS
local ESP = true
local LINE = true
local HITBOX = false
local AIMLOCK = false
local HITBOX_SIZE = Vector3.new(4,4,4)

-- DATA
local CACHE = {}

--================ SAVE KEY =================--

local function saveKey(k)
    pcall(function()
        if writefile then writefile(FILE, k) end
        if getgenv then getgenv().KEY = k end
    end)
end

local function loadKey()
    local k
    pcall(function()
        if readfile and isfile and isfile(FILE) then
            k = readfile(FILE)
        end
    end)
    if not k and getgenv then
        k = getgenv().KEY
    end
    return k
end

