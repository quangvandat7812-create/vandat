local function setupPlayer(p)
    local function onChar()
        task.wait(0.3)
        createESP(p)
        createSkeleton(p)
        applyHitbox(p)
    end

    if p.Character then
        onChar()
    end

    p.CharacterAdded:Connect(onChar)
end

