--================ MENU =================--

local function createMenu()
    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,250,0,270)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(20,20,20)
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,35)
    title.Text = "Menu Vandatdz Esp"
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.TextStrokeTransparency = 0
    title.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18

    local function toggle(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,32)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")
        b.BackgroundColor3 = Color3.fromRGB(35,35,35)

        b.TextColor3 = Color3.fromRGB(255,255,255)
        b.TextStrokeTransparency = 0
        b.TextStrokeColor3 = Color3.fromRGB(0,0,0)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 15

        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    toggle("ESP",45,ESP,function(v) ESP=v end)
    toggle("LINE",85,LINE,function(v) LINE=v end)
    toggle("HITBOX",125,HITBOX,function(v) HITBOX=v end)
    toggle("AIMLOCK",165,AIMLOCK,function(v) AIMLOCK=v end)
    toggle("SKELETON",205,SKELETON,function(v) SKELETON=v end)

    -- DRAG
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag=true start=i.Position pos=main.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.Touch then
            local d=i.Position-start
            main.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then drag=false end
    end)

    -- LOGO
    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,65,0,65)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "rbxassetid://127839480332201"
    logo.BackgroundTransparency = 1

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)
end

