--// VANDATDZ ESP + AIM + DRAG MENU (FIX FULL)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local ESP_ENABLED = true
local AIMLOOK_ENABLED = false

-- GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0,200,0,150)
Main.Position = UDim2.new(0,100,0,200)
Main.BackgroundColor3 = Color3.fromRGB(25,25,25)

local TopBar = Instance.new("TextLabel", Main)
TopBar.Size = UDim2.new(1,0,0,30)
TopBar.BackgroundColor3 = Color3.fromRGB(0,0,0)
TopBar.Text = "VANDATDZ MENU"
TopBar.TextColor3 = Color3.fromRGB(255,255,255)

local ToggleESP = Instance.new("TextButton", Main)
ToggleESP.Size = UDim2.new(1,-20,0,30)
ToggleESP.Position = UDim2.new(0,10,0,40)
ToggleESP.Text = "ESP: ON"
ToggleESP.BackgroundColor3 = Color3.fromRGB(40,40,40)
ToggleESP.TextColor3 = Color3.fromRGB(255,255,255)

local ToggleAim = Instance.new("TextButton", Main)
ToggleAim.Size = UDim2.new(1,-20,0,30)
ToggleAim.Position = UDim2.new(0,10,0,80)
ToggleAim.Text = "AIM: OFF"
ToggleAim.BackgroundColor3 = Color3.fromRGB(40,40,40)
ToggleAim.TextColor3 = Color3.fromRGB(255,255,255)

-- DRAG CHUẨN (FIX)
local dragging = false
local dragStart
local startPos

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

TopBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- TOGGLE
ToggleESP.MouseButton1Click:Connect(function()
	ESP_ENABLED = not ESP_ENABLED
	ToggleESP.Text = "ESP: "..(ESP_ENABLED and "ON" or "OFF")
end)

ToggleAim.MouseButton1Click:Connect(function()
	AIMLOOK_ENABLED = not AIMLOOK_ENABLED
	ToggleAim.Text = "AIM: "..(AIMLOOK_ENABLED and "ON" or "OFF")
end)

-- GET CLOSEST
local function GetClosestPlayer()
	local closest, dist = nil, math.huge

	for _,v in pairs(Players:GetPlayers()) do
		if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
			local mag = (LocalPlayer.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
			if mag < dist then
				dist = mag
				closest = v
			end
		end
	end

	return closest
end

-- AIMLOOK
RunService.RenderStepped:Connect(function()
	if AIMLOOK_ENABLED and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local target = GetClosestPlayer()
		if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
		end
	end
end)

-- ESP FULL
local function CreateESP(player)
	if player == LocalPlayer then return end

	local Box = Drawing.new("Square")
	Box.Color = Color3.fromRGB(255,0,0)
	Box.Thickness = 2
	Box.Filled = false

	local Line = Drawing.new("Line")
	Line.Color = Color3.fromRGB(0,255,0)
	Line.Thickness = 1

	local Text = Drawing.new("Text")
	Text.Size = 13
	Text.Color = Color3.fromRGB(255,255,255)
	Text.Center = true
	Text.Outline = true

	RunService.RenderStepped:Connect(function()
		if not ESP_ENABLED then
			Box.Visible = false
			Line.Visible = false
			Text.Visible = false
			return
		end

		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character then
			local hrp = char.HumanoidRootPart
			local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

			if onScreen then
				local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)

				Box.Size = Vector2.new(50,80)
				Box.Position = Vector2.new(pos.X - 25, pos.Y - 40)
				Box.Visible = true

				Line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
				Line.To = Vector2.new(pos.X, pos.Y)
				Line.Visible = true

				Text.Position = Vector2.new(pos.X, pos.Y - 50)
				Text.Text = player.Name.." ["..dist.."m]"
				Text.Visible = true
			else
				Box.Visible = false
				Line.Visible = false
				Text.Visible = false
			end
		else
			Box.Visible = false
			Line.Visible = false
			Text.Visible = false
		end
	end)
end

-- LOAD
for _,v in pairs(Players:GetPlayers()) do
	CreateESP(v)
end

Players.PlayerAdded:Connect(CreateESP)
