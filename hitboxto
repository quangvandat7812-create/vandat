--// ESP + AIMLOOK by vandatdz

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local ESP_ENABLED = true
local AIMLOOK_ENABLED = false

-- GUI
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)

local ToggleESP = Instance.new("TextButton", ScreenGui)
ToggleESP.Size = UDim2.new(0,120,0,40)
ToggleESP.Position = UDim2.new(0,20,0,200)
ToggleESP.Text = "ESP: ON"
ToggleESP.BackgroundColor3 = Color3.fromRGB(0,0,0)
ToggleESP.TextColor3 = Color3.fromRGB(255,255,255)

local ToggleAim = Instance.new("TextButton", ScreenGui)
ToggleAim.Size = UDim2.new(0,120,0,40)
ToggleAim.Position = UDim2.new(0,20,0,250)
ToggleAim.Text = "AIM: OFF"
ToggleAim.BackgroundColor3 = Color3.fromRGB(0,0,0)
ToggleAim.TextColor3 = Color3.fromRGB(255,255,255)

-- Toggle ESP
ToggleESP.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    ToggleESP.Text = "ESP: "..(ESP_ENABLED and "ON" or "OFF")
end)

-- Toggle AIMLOOK
ToggleAim.MouseButton1Click:Connect(function()
    AIMLOOK_ENABLED = not AIMLOOK_ENABLED
    ToggleAim.Text = "AIM: "..(AIMLOOK_ENABLED and "ON" or "OFF")
end)

-- Get nearest player
local function GetClosestPlayer()
    local closest = nil
    local shortest = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude

            if distance < shortest then
                shortest = distance
                closest = player
            end
        end
    end

    return closest
end

-- AimLook loop
RunService.RenderStepped:Connect(function()
    if AIMLOOK_ENABLED and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local targetPos = target.Character.HumanoidRootPart.Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end
    end
end)

-- ESP function
local function CreateESP(player)
    if player == LocalPlayer then return end

    local Box = Drawing.new("Square")
    Box.Color = Color3.fromRGB(255,0,0)
    Box.Thickness = 2
    Box.Filled = false

    local Line = Drawing.new("Line")
    Line.Color = Color3.fromRGB(0,255,0)
    Line.Thickness = 1

    local Text = Drawing.new("Text")
    Text.Size = 13
    Text.Color = Color3.fromRGB(255,255,255)
    Text.Center = true
    Text.Outline = true

    RunService.RenderStepped:Connect(function()
        if not ESP_ENABLED then
            Box.Visible = false
            Line.Visible = false
            Text.Visible = false
            return
        end

        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character then
            local hrp = char.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)

                Box.Size = Vector2.new(50, 80)
                Box.Position = Vector2.new(pos.X - 25, pos.Y - 40)
                Box.Visible = true

                Line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                Line.To = Vector2.new(pos.X, pos.Y)
                Line.Visible = true

                Text.Position = Vector2.new(pos.X, pos.Y - 50)
                Text.Text = player.Name.." ["..distance.."m]"
                Text.Visible = true
            else
                Box.Visible = false
                Line.Visible = false
                Text.Visible = false
            end
        else
            Box.Visible = false
            Line.Visible = false
            Text.Visible = false
        end
    end)
end

-- Load ESP
for _,v in pairs(Players:GetPlayers()) do
    CreateESP(v)
end

Players.PlayerAdded:Connect(CreateESP)
