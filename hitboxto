--// BASIC MENU UI (DRAG + TOGGLE)

local UIS = game:GetService("UserInputService")

-- GUI
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)

local Main = Instance.new("Frame", ScreenGui)
Main.Size = UDim2.new(0,200,0,150)
Main.Position = UDim2.new(0,20,0,200)
Main.BackgroundColor3 = Color3.fromRGB(25,25,25)

local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1,0,0,30)
Title.Text = "Menu Vandatdz"
Title.TextColor3 = Color3.new(1,1,1)
Title.BackgroundTransparency = 1

-- NÚT ESP (demo toggle)
local ESPBtn = Instance.new("TextButton", Main)
ESPBtn.Size = UDim2.new(0.8,0,0,30)
ESPBtn.Position = UDim2.new(0.1,0,0.4,0)
ESPBtn.Text = "ESP: ON"
ESPBtn.BackgroundColor3 = Color3.fromRGB(0,170,255)

local ESP = true

ESPBtn.MouseButton1Click:Connect(function()
    ESP = not ESP
    ESPBtn.Text = "ESP: "..(ESP and "ON" or "OFF")
end)

-- TOGGLE MENU (RightShift)
UIS.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
    end
end)

-- DRAG
local dragging, dragStart, startPos

Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
