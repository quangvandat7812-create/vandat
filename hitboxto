--================ MENU =================--

local function createMenu()
    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,250,0,270)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(20,20,20)
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,35)
    title.Text = "Menu Vandatdz Esp"
    title.BackgroundTransparency = 1
    fixText(title)

    local function toggle(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,32)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")
        b.BackgroundColor3 = Color3.fromRGB(35,35,35)

        fixText(b)

        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    toggle("ESP",45,ESP,function(v) ESP=v end)
    toggle("LINE",85,LINE,function(v) LINE=v end)
    toggle("HITBOX",125,HITBOX,function(v) HITBOX=v end)
    toggle("AIMLOCK",165,AIMLOCK,function(v) AIMLOCK=v end)
    toggle("SKELETON",205,SKELETON,function(v) SKELETON=v end)

    -- DRAG
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag=true start=i.Position pos=main.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.Touch then
            local d=i.Position-start
            main.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then drag=false end
    end)

    -- LOGO
    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,65,0,65)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "rbxassetid://127839480332201"
    logo.BackgroundTransparency = 1

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)
end

--================ ESP + SKELETON =================--

local function esp(p)
    if p==LocalPlayer then return end

    local line=Drawing.new("Line")
    local text=Drawing.new("Text")

    -- TEXT FIX ESP
    text.Size = 16
    text.Center = true
    text.Outline = true
    text.Color = Color3.fromRGB(255,255,255)
    text.Font = 2

    local function newLine()
        local l = Drawing.new("Line")
        l.Thickness = 2
        l.Color = Color3.fromRGB(0,255,255)
        return l
    end

    local bones = {
        newLine(), newLine(), newLine(), newLine(), newLine()
    }

    RunService.RenderStepped:Connect(function()
        if not p.Parent then
            line:Remove() text:Remove()
            for _,b in pairs(bones) do b:Remove() end
            return
        end

        local c=p.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local pos,vis=Camera:WorldToViewportPoint(c.HumanoidRootPart.Position)

            if ESP and vis then
                text.Text="@"..p.Name
                text.Position=Vector2.new(pos.X,pos.Y-30)
                text.Visible=true
                text.Transparency = 1

                if LINE then
                    line.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To=Vector2.new(pos.X,pos.Y)
                    line.Visible=true
                else line.Visible=false end
            else
                text.Visible=false line.Visible=false
            end

            if SKELETON then
                local function gp(part)
                    local p2=Camera:WorldToViewportPoint(part.Position)
                    return Vector2.new(p2.X,p2.Y)
                end

                local head=c:FindFirstChild("Head")
                local root=c:FindFirstChild("HumanoidRootPart")
                local la=c:FindFirstChild("LeftHand") or c:FindFirstChild("Left Arm")
                local ra=c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")
                local ll=c:FindFirstChild("LeftFoot") or c:FindFirstChild("Left Leg")
                local rl=c:FindFirstChild("RightFoot") or c:FindFirstChild("Right Leg")

                if head and root then
                    local h=gp(head)
                    local r=gp(root)

                    bones[1].From=h bones[1].To=r bones[1].Visible=true
                    if la then bones[2].From=r bones[2].To=gp(la) bones[2].Visible=true end
                    if ra then bones[3].From=r bones[3].To=gp(ra) bones[3].Visible=true end
                    if ll then bones[4].From=r bones[4].To=gp(ll) bones[4].Visible=true end
                    if rl then bones[5].From=r bones[5].To=gp(rl) bones[5].Visible=true end
                end
            else
                for _,b in pairs(bones) do b.Visible=false end
            end
        end
    end)
end

