--================ MENU =================--
local function createMenu()
    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,230,0,260)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    local function toggle(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,30)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    toggle("ESP",40,ESP,function(v) ESP=v end)
    toggle("LINE",80,LINE,function(v) LINE=v end)
    toggle("HITBOX",120,HITBOX,function(v) HITBOX=v end)
    toggle("SKELETON",160,SKELETON,function(v) SKELETON=v end)
    toggle("AIM",200,AIM,function(v) AIM=v end)

    -- DRAG
    local dragging, dragStart, startPos
    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function()
        dragging = false
    end)

    -- LOGO
    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,60,0,60)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "rbxassetid://7072718362"

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)
end

--================ SYSTEM =================--
local CACHE = {}

local function setup(p)
    if p == LocalPlayer then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")
    local lines = {}

    for i=1,5 do
        local l = Drawing.new("Line")
        l.Thickness = 2
        l.Color = Color3.fromRGB(0,255,255)
        table.insert(lines,l)
    end

    RunService.RenderStepped:Connect(function()
        if not p or not p.Parent then return end
        local c = p.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not c or not hrp then return end

        local pos, vis = Camera:WorldToViewportPoint(hrp.Position)

        -- ESP
        if ESP and vis then
            text.Text = "@"..p.Name
            text.Position = Vector2.new(pos.X,pos.Y-30)
            text.Visible = true

            if LINE then
                line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X,pos.Y)
                line.Visible = true
            end
        else
            text.Visible = false
            line.Visible = false
        end

        -- HITBOX (Highlight)
        local hl = c:FindFirstChild("HL")
        if HITBOX then
            if not hl then
                hl = Instance.new("Highlight", c)
                hl.Name = "HL"
                hl.FillColor = Color3.fromRGB(255,0,0)
            end
        else
            if hl then hl:Destroy() end
        end

        -- SKELETON
        if SKELETON and vis then
            local head = c:FindFirstChild("Head")
            if head then
                local h = Camera:WorldToViewportPoint(head.Position)
                lines[1].From = Vector2.new(h.X,h.Y)
                lines[1].To = Vector2.new(pos.X,pos.Y)
                lines[1].Visible = true
            end
        else
            for _,l in pairs(lines) do l.Visible = false end
        end

        -- AIM ASSIST
        if AIM and vis then
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, hrp.Position),
                0.05
            )
        end
    end)
end

--================ START =================--
local function start()
    createMenu()

    for _,v in pairs(Players:GetPlayers()) do
        setup(v)
    end

    Players.PlayerAdded:Connect(setup)
end

-- AUTO LOGIN
if loadKey() == KEY then
    start()
else
    frame.Visible = true
end

btn.MouseButton1Click:Connect(function()
    if box.Text == KEY then
        saveKey(KEY)
        start()
    end
end)
