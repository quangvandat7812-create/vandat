
--// MENU CONTROL (KHÔNG ĐỤNG ESP)

local UIS = game:GetService("UserInputService")

local ScreenGui2 = Instance.new("ScreenGui", game.CoreGui)

local Main = Instance.new("Frame", ScreenGui2)
Main.Size = UDim2.new(0,200,0,120)
Main.Position = UDim2.new(0,20,0,260)
Main.BackgroundColor3 = Color3.fromRGB(20,20,20)

local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1,0,0,30)
Title.Text = "Menu Vandatdz"
Title.TextColor3 = Color3.new(1,1,1)
Title.BackgroundTransparency = 1

local ESPBtn = Instance.new("TextButton", Main)
ESPBtn.Size = UDim2.new(0.8,0,0,30)
ESPBtn.Position = UDim2.new(0.1,0,0.5,0)
ESPBtn.Text = "ESP: ON"
ESPBtn.BackgroundColor3 = Color3.fromRGB(0,170,255)
ESPBtn.TextColor3 = Color3.new(1,1,1)

-- sync với biến ESP gốc
ESPBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    ESPBtn.Text = "ESP: "..(ESP_ENABLED and "ON" or "OFF")
end)

-- toggle menu (RightShift)
UIS.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
    end
end)

-- drag
local dragging, dragStart, startPos

Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

--// ESP by vandatdz
--// GUI Toggle: RightShift

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local ESP_ENABLED = true

-- GUI
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Toggle = Instance.new("TextButton", ScreenGui)

Toggle.Size = UDim2.new(0,120,0,40)
Toggle.Position = UDim2.new(0,20,0,200)
Toggle.Text = "ESP: ON"
Toggle.BackgroundColor3 = Color3.fromRGB(0,0,0)
Toggle.TextColor3 = Color3.fromRGB(255,255,255)

Toggle.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    Toggle.Text = "ESP: "..(ESP_ENABLED and "ON" or "OFF")
end)

-- ESP function
local function CreateESP(player)
    if player == LocalPlayer then return end

    local Box = Drawing.new("Square")
    Box.Color = Color3.fromRGB(255,0,0)
    Box.Thickness = 2
    Box.Filled = false

    local Line = Drawing.new("Line")
    Line.Color = Color3.fromRGB(0,255,0)
    Line.Thickness = 1

    local Text = Drawing.new("Text")
    Text.Size = 13
    Text.Color = Color3.fromRGB(255,255,255)
    Text.Center = true
    Text.Outline = true

    RunService.RenderStepped:Connect(function()
        if not ESP_ENABLED then
            Box.Visible = false
            Line.Visible = false
            Text.Visible = false
            return
        end

        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)

                Box.Size = Vector2.new(50, 80)
                Box.Position = Vector2.new(pos.X - 25, pos.Y - 40)
                Box.Visible = true

                Line.From = Vector2.new(workspace.CurrentCamera.ViewportSize.X/2, workspace.CurrentCamera.ViewportSize.Y)
                Line.To = Vector2.new(pos.X, pos.Y)
                Line.Visible = true

                Text.Position = Vector2.new(pos.X, pos.Y - 50)
                Text.Text = player.Name.." ["..distance.."m]"
                Text.Visible = true
            else
                Box.Visible = false
                Line.Visible = false
                Text.Visible = false
            end
        else
            Box.Visible = false
            Line.Visible = false
            Text.Visible = false
        end
    end)
end

-- Load ESP for all players
for _,v in pairs(Players:GetPlayers()) do
    CreateESP(v)
end

Players.PlayerAdded:Connect(CreateESP)
