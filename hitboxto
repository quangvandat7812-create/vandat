--================ SAVE / LOAD KEY =================--

local function saveKey(key)
    pcall(function()
        if writefile then
            writefile(FILE_NAME, key)
        end
        if getgenv then
            getgenv().VANDAT_KEY = key
        end
    end)
end

local function loadKey()
    local key = nil

    pcall(function()
        if readfile and isfile and isfile(FILE_NAME) then
            key = readfile(FILE_NAME)
        end
    end)

    if not key then
        pcall(function()
            if getgenv then
                key = getgenv().VANDAT_KEY
            end
        end)
    end

    return key
end

