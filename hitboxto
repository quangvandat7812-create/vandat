--================ MENU =================--

local function createMenu()
    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,240,0,260)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,30)
    title.Text = "Menu Vandatdz Esp"
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.BackgroundTransparency = 1

    local function toggle(name,y,state,callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.8,0,0,30)
        b.Position = UDim2.new(0.1,0,0,y)
        b.Text = name..": "..(state and "ON" or "OFF")
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
        Instance.new("UICorner", b)

        b.MouseButton1Click:Connect(function()
            state = not state
            b.Text = name..": "..(state and "ON" or "OFF")
            callback(state)
        end)
    end

    toggle("ESP",40,ESP,function(v) ESP=v end)
    toggle("LINE",80,LINE,function(v) LINE=v end)
    toggle("HITBOX",120,HITBOX,function(v) HITBOX=v end)
    toggle("AIMLOCK",160,AIMLOCK,function(v) AIMLOCK=v end)
    toggle("SKELETON",200,SKELETON,function(v) SKELETON=v end)

    -- DRAG
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            drag=true start=i.Position pos=main.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.Touch then
            local d=i.Position-start
            main.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then drag=false end
    end)

    -- LOGO
    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,65,0,65)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "rbxassetid://127839480332201"
    logo.BackgroundTransparency = 1

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)
end

--================ HITBOX (RED BODY) =================--

local function hitbox(p)
    local h

    local function apply(c)
        if h then h:Destroy() end
        h = Instance.new("Highlight")
        h.FillColor = Color3.fromRGB(255,0,0)
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255,0,0)
        h.Adornee = c
        h.Parent = c
    end

    p.CharacterAdded:Connect(function(c)
        task.wait(0.5)
        if HITBOX then apply(c) end
    end)

    RunService.RenderStepped:Connect(function()
        local c = p.Character
        if c then
            if HITBOX then
                if not h then apply(c) end
            else
                if h then h:Destroy() h=nil end
            end
        end
    end)
end

--================ AIMLOCK =================--

local function getClosest()
    local target,dist=nil,AIM_FOV
    for _,v in pairs(Players:GetPlayers()) do
        if v~=LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
            local pos,vis=Camera:WorldToViewportPoint(v.Character.Head.Position)
            if vis then
                local d=(Vector2.new(pos.X,pos.Y)-Camera.ViewportSize/2).Magnitude
                if d<dist then dist=d target=v end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if AIMLOCK then
        local t=getClosest()
        if t and t.Character then
            Camera.CFrame=CFrame.new(Camera.CFrame.Position,t.Character.Head.Position)
        end
    end
end)

--================ ESP + SKELETON =================--

local function esp(p)
    if p==LocalPlayer then return end

    local line=Drawing.new("Line")
    local text=Drawing.new("Text")

    local bones={}
    local function lineBone()
        local l=Drawing.new("Line")
        l.Thickness=1
        return l
    end

    bones = {
        lineBone(),lineBone(),lineBone(),lineBone(),lineBone()
    }

    RunService.RenderStepped:Connect(function()
        if not p.Parent then
            line:Remove() text:Remove()
            for _,b in pairs(bones) do b:Remove() end
            return
        end

        local c=p.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local pos,vis=Camera:WorldToViewportPoint(c.HumanoidRootPart.Position)

            if ESP and vis then
                text.Text="@"..p.Name
                text.Position=Vector2.new(pos.X,pos.Y-30)
                text.Visible=true

                if LINE then
                    line.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    line.To=Vector2.new(pos.X,pos.Y)
                    line.Visible=true
                else line.Visible=false end
            else
                text.Visible=false line.Visible=false
            end

            if SKELETON and c:FindFirstChild("Head") then
                local parts={"Head","HumanoidRootPart"}
                local pts={}
                for _,part in pairs(parts) do
                    local p2,vis2=Camera:WorldToViewportPoint(c[part].Position)
                    pts[part]=Vector2.new(p2.X,p2.Y)
                end
                bones[1].From=pts.Head
                bones[1].To=pts.HumanoidRootPart
                bones[1].Visible=true
            else
                for _,b in pairs(bones) do b.Visible=false end
            end
        end
    end)
end

