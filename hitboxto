--================ MENU =================--

local function createMenu()

    frame:Destroy()

    local main = Instance.new("Frame", gui)
    main.Size = UDim2.new(0,250,0,260)
    main.Position = UDim2.new(0,20,0,200)
    main.BackgroundColor3 = Color3.fromRGB(25,25,25)
    main.Active = true
    Instance.new("UICorner", main)

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,35)
    title.Text = "Menu Vandatdz ESP"
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(0,255,255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18

    local function createBtn(text, y, state, callback)
        local b = Instance.new("TextButton", main)
        b.Size = UDim2.new(0.85,0,0,35)
        b.Position = UDim2.new(0.075,0,0,y)
        b.BackgroundColor3 = Color3.fromRGB(40,40,40)
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 16
        Instance.new("UICorner", b)

        local function update()
            b.Text = text.." : "..(state and "ON" or "OFF")
        end

        update()

        b.MouseButton1Click:Connect(function()
            state = not state
            update()
            callback(state)
        end)
    end

    createBtn("ESP",50,ESP,function(v) ESP=v end)
    createBtn("LINE",95,LINE,function(v) LINE=v end)
    createBtn("HITBOX",140,HITBOX,function(v) HITBOX=v end)
    createBtn("AIMLOCK",185,AIMLOCK,function(v) AIMLOCK=v end)

    -- DRAG MENU
    local dragging, dragStart, startPos

    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function()
        dragging = false
    end)

    -- LOGO
    local logo = Instance.new("ImageButton", gui)
    logo.Size = UDim2.new(0,65,0,65)
    logo.Position = UDim2.new(1,-80,0,120)
    logo.Image = "https://www.roblox.com/asset/?id=127839480332201"
    logo.BackgroundTransparency = 1

    local open = true
    logo.MouseButton1Click:Connect(function()
        open = not open
        main.Visible = open
    end)

    -- DRAG LOGO
    local draggingLogo, dragStartLogo, startPosLogo

    logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingLogo = true
            dragStartLogo = input.Position
            startPosLogo = logo.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if draggingLogo and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartLogo
            logo.Position = UDim2.new(startPosLogo.X.Scale, startPosLogo.X.Offset + delta.X, startPosLogo.Y.Scale, startPosLogo.Y.Offset + delta.Y)
        end
    end)

    UIS.InputEnded:Connect(function()
        draggingLogo = false
    end)
end

--================ PLAYER =================--

local function addPlayer(p)
    if p == LocalPlayer then return end

    local line = Drawing.new("Line")
    local text = Drawing.new("Text")

    text.Size = 14
    text.Center = true
    text.Outline = true

    CACHE[p] = {
        line = line,
        text = text,
        highlight = nil
    }
end

local function removePlayer(p)
    if CACHE[p] then
        CACHE[p].line:Remove()
        CACHE[p].text:Remove()
        if CACHE[p].highlight then
            CACHE[p].highlight:Destroy()
        end
        CACHE[p] = nil
    end
end

--================ MAIN LOOP =================--

RunService.RenderStepped:Connect(function()

    for p,data in pairs(CACHE) do
        local char = p.Character

        if not char or not char:FindFirstChild("HumanoidRootPart") then
            data.text.Visible = false
            data.line.Visible = false
            continue
        end

        local root = char.HumanoidRootPart
        local pos, vis = Camera:WorldToViewportPoint(root.Position)

        -- ESP
        if ESP and vis then
            data.text.Text = "@"..p.Name
            data.text.Position = Vector2.new(pos.X,pos.Y-30)
            data.text.Visible = true
        else
            data.text.Visible = false
        end

        -- LINE
        if LINE and vis then
            data.line.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
            data.line.To = Vector2.new(pos.X,pos.Y)
            data.line.Visible = true
        else
            data.line.Visible = false
        end

        -- HITBOX
        if HITBOX then
            if not data.highlight then
                data.highlight = Instance.new("Highlight")
                data.highlight.FillTransparency = 1
                data.highlight.OutlineColor = Color3.fromRGB(255,0,0)
                data.highlight.Parent = char
            end
            root.Size = HITBOX_SIZE
        else
            if data.highlight then
                data.highlight:Destroy()
                data.highlight = nil
            end
            root.Size = Vector3.new(2,2,1)
        end
    end
end)

--================ START =================--

local function start()
    createMenu()

    for _,p in pairs(Players:GetPlayers()) do
        addPlayer(p)
    end

    Players.PlayerAdded:Connect(addPlayer)
    Players.PlayerRemoving:Connect(removePlayer)
end

-- AUTO LOGIN
if loadKey() == KEY then
    start()
end

btn.MouseButton1Click:Connect(function()
    if box.Text == KEY then
        saveKey(KEY)
        start()
    else
        box.Text = ""
