--================ SAVE KEY =================--

local function saveKey(k)
    pcall(function()
        if writefile then writefile(FILE, k) end
        if getgenv then getgenv().KEY = k end
    end)
end

local function loadKey()
    local k
    pcall(function()
        if readfile and isfile and isfile(FILE) then
            k = readfile(FILE)
        end
    end)
    if not k and getgenv then
        k = getgenv().KEY
    end
    return k
end

