    killBtn.BackgroundColor3 = AUTO_KILL_ENABLED and Color3.fromRGB(170,0,0) or Color3.fromRGB(40,40,40)
    if AUTO_KILL_ENABLED then spawn(autoKillLoop) end
end)

-- AIMBOT TỰ ĐỘNG
local function aimbotLoop()
    while AIMBOT_ENABLED do
        wait(0.015) -- mượt mà
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end

        local closest, minDist = nil, math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr \~= player and plr.Character and plr.Character:FindFirstChild("Head") then
                local dist = (player.Character.HumanoidRootPart.Position - plr.Character.Head.Position).Magnitude
                if dist < minDist and dist < 200 then
                    minDist = dist
                    closest = plr.Character.Head
                end
            end
        end

        if closest then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.85) -- mượt
        end
    end
end

aimbotBtn.MouseButton1Click:Connect(function()
    AIMBOT_ENABLED = not AIMBOT_ENABLED
    aimbotBtn.Text = "Aimbot Tự Động: " .. (AIMBOT_ENABLED and "ON" or "OFF")
    aimbotBtn.BackgroundColor3 = AIMBOT_ENABLED and Color3.fromRGB(170,0,0) or Color3.fromRGB(40,40,40)
    
    if AIMBOT_ENABLED then
        spawn(aimbotLoop)
    end
end)

