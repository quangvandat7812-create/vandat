-- ESP
local function createESP(char)
    if espTable[char] or char == player.Character then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = root
    box.Size = root.Size + Vector3.new(2,4,2)
    box.Color3 = Color3.fromRGB(255,0,0)
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.Parent = root

    espTable[char] = box
end

local function toggleESP()
    ESP_ENABLED = not ESP_ENABLED
    espBtn.Text = "ESP: " .. (ESP_ENABLED and "ON" or "OFF")
    espBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(0,170,0) or Color3.fromRGB(40,40,40)

    if ESP_ENABLED then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character then createESP(plr.Character) end
        end
    else
        for _, v in pairs(espTable) do v:Destroy() end
        espTable = {}
    end
end

espBtn.MouseButton1Click:Connect(toggleESP)

-- Hitbox
hitBoxInput.FocusLost:Connect(function()
    HITBOX_SIZE = tonumber(hitBoxInput.Text) or 5
    hitLabel.Text = "Hitbox Size: " .. HITBOX_SIZE
    for _, plr in pairs(Players:GetPlayers()) do
        if plr \~= player and plr.Character then
            for _, part in pairs(plr.Character:GetChildren()) do
                if part:IsA("BasePart") and part.Name \~= "HumanoidRootPart" then
                    part.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
                end
            end
        end
    end
end)

-- Auto Kill
local function autoKillLoop()
    while AUTO_KILL_ENABLED do
        wait(0.1)
        if not player.Character then continue end
        local closest, minDist = nil, math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr \~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (player.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist and dist < 40 then
                    minDist = dist
                    closest = plr.Character
                end
            end
        end
        if closest and closest:FindFirstChild("Humanoid") then
            closest.Humanoid.Health = 0
        end
    end
end

