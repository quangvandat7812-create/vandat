-- HITBOX FULL BODY
local function ApplyHitbox(char)
	for _,p in pairs(char:GetChildren()) do
		if p:IsA("BasePart") then
			if not p:FindFirstChild("OriginalSize") then
				local v = Instance.new("Vector3Value", p)
				v.Name = "OriginalSize"
				v.Value = p.Size
			end

			if HITBOX_ENABLED then
				p.Size = Vector3.new(HITBOX_SIZE,HITBOX_SIZE,HITBOX_SIZE)
				p.Transparency = 0.5
				p.Material = Enum.Material.Neon
				p.Color = Color3.fromRGB(255,0,0)
				p.CanCollide = false
			else
				local o = p:FindFirstChild("OriginalSize")
				if o then p.Size = o.Value end
				p.Transparency = 0
				p.Material = Enum.Material.Plastic
			end
		end
	end
end

-- ESP
local function SetupESP(player)
	if player == LocalPlayer then return end

	local function Apply(char)
		local hrp = char:WaitForChild("HumanoidRootPart",10)
		if not hrp then return end

		if char:FindFirstChild("VANDATDZ_ESP") then return end

		local f = Instance.new("Folder", char)
		f.Name = "VANDATDZ_ESP"

		local hl = Instance.new("Highlight", f)

		local bill = Instance.new("BillboardGui", f)
		bill.Size = UDim2.new(0,120,0,40)
		bill.AlwaysOnTop = true
		bill.Adornee = hrp

		local txt = Instance.new("TextLabel", bill)
		txt.Size = UDim2.new(1,0,1,0)
		txt.BackgroundTransparency = 1
		txt.TextScaled = true

		RunService.RenderStepped:Connect(function()
			if not char or not char.Parent then return end

			if ESP_ENABLED then
				hl.Enabled = true
				bill.Enabled = true

				if player.Team == LocalPlayer.Team then
					hl.FillColor = Color3.fromRGB(0,255,0)
					txt.TextColor3 = Color3.fromRGB(0,255,0)
				else
					hl.FillColor = Color3.fromRGB(255,0,0)
					txt.TextColor3 = Color3.fromRGB(255,0,0)
				end

				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local d = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
					txt.Text = player.Name.." ["..d.."m]"
				end
			else
				hl.Enabled = false
				bill.Enabled = false
			end

			ApplyHitbox(char)
		end)
	end

	task.spawn(function()
		if player.Character then Apply(player.Character) end
		player.CharacterAdded:Connect(function(c)
			task.wait(0.5)
			Apply(c)
		end)
	end)
end

for _,v in ipairs(Players:GetPlayers()) do
	SetupESP(v)
end

Players.PlayerAdded:Connect(SetupESP)

-- AIM
local function GetClosest()
	local c,d=nil,math.huge
	for _,v in pairs(Players:GetPlayers()) do
		if v~=LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
			local m=(LocalPlayer.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude
			if m<d then d=m c=v end
		end
	end
	return c
end

RunService.RenderStepped:Connect(function()
	if AIM_ENABLED and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local t=GetClosest()
		if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Character.HumanoidRootPart.Position)
		end
	end
end)
